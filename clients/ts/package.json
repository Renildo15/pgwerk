{
  "name": "@pgwerk/remote-worker",
  "version": "0.1.0",
  "description": "Run pgwerk jobs from any machine with outbound HTTPS: a remote worker for protocol v1.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.3" },
  "main": "./dist/index.js",
