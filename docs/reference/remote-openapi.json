  "paths": {
    "/remote/v1/claim": {
      "post": {
        "deprecated": false,
        "operationId": "RemoteV1ClaimClaim",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description": "a job, leased to this worker"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Document created, URL follows",
            "headers": {}
          },
          "204": {
            "description": "nothing to claim within the wait, or a spent claim_id"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "bad_request or protocol"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "unauthorized: invalid, revoked or wrong kind of token (stop); session_expired: register again"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "draining"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "too_large"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "rate_limited"
          }
        },
        "summary": "Long-poll for one job",
        "tags": [
          "remote workers v1"
        ]
      }
    },
